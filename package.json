{
  "name": "xueyifang-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "学艺坊 · 校园技能服务与担保交易平台",
  "workspaces": [
    "xueyifang-frontend"
  ],
  "scripts": {
