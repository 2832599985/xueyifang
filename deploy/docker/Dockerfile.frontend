# ==================== Stage 1: Build ====================
FROM node:18-alpine AS build

WORKDIR /app

# Copy package.json only (ignore lock file, regenerate for Linux)
COPY package.json ./
RUN npm install

# Copy source code and build (type-check + vite build)
COPY . .
RUN npm run build

# ==================== Stage 2: Run ====================
FROM nginx:alpine

# Remove default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy built files
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
