# 本地开发私有配置模板（复制为 application-local.yml 使用，切勿提交真实凭据）
# 启动命令：mvn spring-boot:run "-Dspring-boot.run.arguments=--spring.profiles.active=local"
spring:
  datasource:
    url: jdbc:mysql://localhost:3306/xueyifang?useSSL=false&serverTimezone=Asia/Shanghai&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&useUnicode=true
    username: root
    password: your-mysql-password

  redis:
    host: localhost
    port: 6379
    password: ""
    database: 2

jwt:
  secret: replace-with-a-random-32-char-secret-key

file:
  storage:
    # 可选 local 或 oss（兼容 MinIO / SeaweedFS / S3）
    type: local
    oss:
      endpoint: http://localhost:9000
      access-key-id: your-access-key-id
      access-key-secret: your-access-key-secret
      bucket-name: xueyifang
      url-prefix: http://localhost:9000/xueyifang
