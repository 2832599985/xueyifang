					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id\": 1,\n  \"isAvailable\": 0\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/trade-location/update",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"trade-location",
						"update"
					]
				},
				"description": "将交易地点设置为不可用状态\n\n需要登录：是"
			},
			"response": []
		},
		{
			"name": "删除交易地点",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/trade-location/1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"trade-location",
						"1"
					]
				},
				"description": "根据地点ID删除交易地点（逻辑删除）\n\n需要登录：是"
			},
			"response": []
		},
		{
			"name": "批量删除交易地点",
			"request": {
				"method": "DELETE",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "[1, 2, 3, 4, 5]"
				},
				"url": {
					"raw": "{{baseUrl}}/trade-location/batch",
					"host": [
						"{{baseUrl}}"
