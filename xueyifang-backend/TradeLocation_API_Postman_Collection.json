				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/trade-location/page?current=1&pageSize=10",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"trade-location",
						"page"
					],
					"query": [
						{
							"key": "current",
							"value": "1",
							"description": "当前页码"
						},
						{
							"key": "pageSize",
							"value": "10",
							"description": "每页大小"
						}
					]
				},
				"description": "分页查询所有交易地点（不筛选可用状态）\n\n需要登录：是"
			},
			"response": []
		},
		{
			"name": "根据ID查询交易地点详情",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/trade-location/1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"trade-location",
						"1"
					]
				},
				"description": "根据地点ID查询交易地点详细信息\n\n需要登录：是"
			},
			"response": []
		},
		{
			"name": "添加交易地点",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"locationName\": \"校园咖啡厅\",\n  \"locationDescription\": \"学生常聚集场所，环境舒适\",\n  \"locationAddress\": \"校园中心广场旁\",\n  \"isAvailable\": 1\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/trade-location/add",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"trade-location",
						"add"
					]
				},
				"description": "添加新的交易地点信息\n\n需要登录：是"
			},
			"response": []
		},
		{
			"name": "添加交易地点（最小参数）",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"locationName\": \"图书馆门口\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/trade-location/add",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"trade-location",
						"add"
					]
				},
				"description": "只传必填参数添加交易地点（地点名称）\n\n需要登录：是"
			},
			"response": []
		},
		{
			"name": "更新交易地点",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id\": 1,\n  \"locationName\": \"新校园咖啡厅\",\n  \"locationDescription\": \"更新后的描述信息\",\n  \"locationAddress\": \"新的详细地址\",\n  \"isAvailable\": 1\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/trade-location/update",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"trade-location",
						"update"
					]
				},
				"description": "根据地点ID更新交易地点信息\n\n需要登录：是"
			},
			"response": []
		},
		{
			"name": "更新交易地点（部分字段）",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"id\": 1,\n  \"locationName\": \"更新后的地点名称\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/trade-location/update",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"trade-location",
						"update"
					]
				},
				"description": "只更新部分字段（只传需要更新的字段）\n\n需要登录：是"
			},
			"response": []
		},
		{
			"name": "设置交易地点为不可用",
			"request": {
				"method": "PUT",
