{
	"info": {
		"_postman_id": "trade-location-api-collection",
		"name": "交易地点管理 API",
		"description": "学易坊后端 - 交易地点管理模块的完整 CRUD 接口集合\n\n使用说明：\n1. 先调用登录接口获取 token\n2. 将 token 设置到环境变量 {{token}} 中\n3. 所有接口会自动携带 Authorization 请求头",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "查询所有可用的交易地点",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/trade-location/list",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"trade-location",
						"list"
					]
				},
				"description": "获取所有可用且未删除的交易地点列表\n\n需要登录：是"
			},
			"response": []
		},
		{
			"name": "查询所有交易地点（包括不可用的）",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/trade-location/list/all",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"trade-location",
						"list",
						"all"
					]
				},
				"description": "获取所有交易地点列表（包括不可用的，但不包括已删除的）\n\n需要登录：是"
			},
			"response": []
		},
		{
			"name": "分页查询交易地点",
			"request": {
				"method": "GET",
				"header": [
					{
						"key": "Authorization",
						"value": "Bearer {{token}}",
						"type": "text",
						"description": "JWT Token 认证"
					}
				],
				"url": {
					"raw": "{{baseUrl}}/trade-location/page?current=1&pageSize=10&isAvailable=1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"trade-location",
						"page"
					],
					"query": [
						{
							"key": "current",
							"value": "1",
							"description": "当前页码"
						},
						{
							"key": "pageSize",
							"value": "10",
							"description": "每页大小"
						},
						{
							"key": "isAvailable",
							"value": "1",
							"description": "是否可用（1=可用, 0=不可用，不传=全部）"
						}
					]
				},
				"description": "分页查询交易地点列表，支持按可用状态筛选\n\n需要登录：是"
			},
			"response": []
		},
		{
			"name": "分页查询所有交易地点（不筛选可用状态）",
